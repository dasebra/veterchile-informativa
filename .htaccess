# ----------------------------------------------------------------------
# Expires headers (for better cache control)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive on

# Your document html
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"

# Media: images, video, audio
  ExpiresByType image/gif "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 0 seconds"
  ExpiresByType image/png "access plus 0 seconds"
  ExpiresByType video/mp4 "access plus 0 seconds"

# CSS and JavaScript
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresDefault "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# Expires headers (for better cache control)
# ----------------------------------------------------------------------
RewriteEngine on

#=======================================================================
#ASIGNACION DE WWW
# RewriteCond %{HTTP_HOST} !=""
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteCond %{HTTPS}s ^on(s)|
# RewriteRule ^ http%1://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

#ASIGNACION DE HTTPS
# RewriteCond %{HTTPS} !on
# RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
#=======================================================================

#=======================================================================
#404
# ErrorDocument 404 /404.php
#ErrorDocument 404 404.html
#Rewriterule ^404$ 400.html[L,R=404]
#=======================================================================

#=======================================================================
# WBS
Rewriterule ^APIV1$ wbs/wbs.php
#=======================================================================

#=======================================================================
# HOME
Rewriterule ^home$ index.php
#=======================================================================

#=======================================================================
# HOME
Rewriterule ^\$ home
#=======================================================================

#=======================================================================
# PROFESIONAL
Rewriterule ^profesionales$ profesionales.php
#=======================================================================
#=======================================================================
# ARCHIVOS INTERNOS
# Documentación y notas de trabajo del proyecto: no deben quedar
# accesibles desde el navegador.
<FilesMatch "\.(md|markdown|log|bak|sql|yml|yaml|json|ini|dist|sh)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Carpetas ocultas y de trabajo (control de versiones, registros, etc.)
RedirectMatch 404 /\.(git|svn|hg|claude|vscode|idea|DS_Store)(/|$)
RedirectMatch 404 /logs?(/|$)
#=======================================================================
